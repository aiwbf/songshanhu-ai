# Core API
LLM_PROVIDER=ollama
LLM_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=minimax-m2.5:cloud
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_HOURS=12
ADMIN_SESSION_IDLE_MINUTES=60
OPENCLAW_ENABLE_SEND=0
OPENCLAW_COMMAND=openclaw.cmd
OFFICIAL_CONTACT=松山湖招生服务热线：0769-38881212
ACTIVE_KNOWLEDGE_YEAR=2025
KNOWLEDGE_YEAR=2025

# Gateway
OPENCLAW_GATEWAY_CONFIG=C:\Users\Administrator\myproj\2024\config\openclaw.sample.json
OPENCLAW_GATEWAY_HOST=127.0.0.1
OPENCLAW_GATEWAY_PORT=8010
OPENCLAW_SHARED_TOKEN_HEADER=X-OpenClaw-Token
OPENCLAW_SHARED_TOKEN=change-me-in-production
OPENCLAW_FALLBACK_AGENT=fallback-human-handoff

# Gateway -> Consultation API
CONSULTATION_ORCHESTRATOR_URL=http://127.0.0.1:8000
CONSULTATION_ORCHESTRATOR_PATH=/api/consultation/orchestrate
CONSULTATION_ORCHESTRATOR_TIMEOUT_MS=6000
