        "required_routing_key_terms": ["channel=feishu", "target=oc_test", "thread_id=thread-xyz", "sender_id=user-123"]
      }
    },
    {
      "id": "rt-openclaw-off-allowlist",
      "suite": "redteam",
      "topic": "OpenClaw allowlist",
